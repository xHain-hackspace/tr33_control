<div class="main p-2" style="width: 1350px">
  <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-2">
    <div class="container-fluid">
    
      <a class="navbar-brand pb-0" href="/"  style="font-size: 1.5rem">
        <img class="d-inline-block align-text-center me-3" src={ Routes.static_path(@socket, "/images/xhain_logo_small.png") } alt="" width="100" height="100">
        <Components.title />
      </a>

      <ul class="navbar-nav me-auto">
        <%= for {name, path} <- @navbar_content do%>
          <li class="nav-item">
            <%= live_redirect name, to: path, class: "nav-link #{if path == @navbar_active_path, do: "active"}" %>
          </li>
        <% end %>
      </ul>      
    </div>
  </nav>

  <p class="alert alert-info" role="alert"
    phx-click="lv:clear-flash"
    phx-value-key="info"><%= live_flash(@flash, :info) %></p>

  <p class="alert alert-danger" role="alert"
    phx-click="lv:clear-flash"
    phx-value-key="error"><%= live_flash(@flash, :error) %></p>


  <%= @inner_content %>
</div>

