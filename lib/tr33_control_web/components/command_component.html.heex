
<div class="one_cmd_wrap">
  <h2 class="section_headline">command settings</h2>
  <div class="one_cmd_option">
      <!-- well, at least an unique id -->
    <label for={"cmd_nummer_#{@command.index + 1}"} class="cmd_option_label label_for_select">command</label>
    <select class="option_select" name="cmd_nummer" id={"cmd_nummer_#{@command.index + 1}"} data-pending-value={@command.index + 1}>
    <!-- hacky solution and doesn't work for selecting commands -->
      <%= all_nums = [1,2,3,4,5,6,7,8]
      all_nums_lit = ["one","two","three","four","five","six","seven","eight"] # : ( nicht hingekriegt
      for num <- all_nums do %>
        <option value={num} selected={num == (@command.index + 1)}>
          <%= Display.humanize(num) %>
        </option>
      <% end %>
    </select>
  </div>

  <.switch name="command_enabled" value={Command.enabled?(@command)} target={@myself} />

  <%= for param <- @enum_params do %>
    <div class="one_cmd_paras">
      <.param_select param={param} target={@myself} />
    </div>
  <% end %>

  <div class="fader_wrap">

    <%= for param <- @value_params do %>
      <div class="one_fader">
        <.param_slider param={param} target={@myself} />
      </div>
    <% end %>
  </div>

  <div class="one_cmd_paras beflipped">
    <h4>Targets</h4>
    <%= for target <- @command_targets do %>
      <button
        type="button"
        class={"flippy text-center list-group-item list-group-item-action #{if Display.target_active?(@command, target), do: "active", else: "" }"}
        phx-click="toggle_target"
        phx-value-target={target}
        phx-target={@myself}
      >
        <%= Display.command_target(target) %>
      </button>
    <% end %>
  </div>

  <%= if @modifiers_active do %>
    <div class="one_cmd_paras beflipped">
    <h4>Modifiers</h4>
          <%= for name <- @modifier_names do %>
            <button
              type="button"
              class={"btn flippy btn-" <> if modifier_active?(@command, name), do: "primary active", else: "secondary"}
              phx-click={if modifier_active?(@command, name), do: "delete_modifier", else: "add_modifier"}
              phx-value-name={name}
              phx-target={@myself}
            >
              <%= Display.humanize(name) %>
            </button>
          <% end %>
    </div>

    <h2 class="section_headline">modefiers settings</h2>

    <div class="modefier_wrap">

      <%= for {name, enums, values} <- @modifier_params do %>
        <form class="one_modefier" phx-change="update_modifier" phx-target={@myself}>
        <!-- maybe better as parameter -->
          <div class="one_cmd_option">
            <label for={name} class="cmd_option_label ">modefier</label>
            <select class="option_select" name={name} id={name}>
                <option value={name} selected>
                  <%= Display.humanize(name) %>
                </option>
            </select>
          </div>

          <input name="name" type="hidden" value={name} />

          <%= for %EnumParam{options: options, name: param_name, value: value} <- enums do %>
            <div class="one_cmd_option">
              <label for={param_name} class="cmd_option_label label_for_select"><%= Display.humanize(param_name) %></label>
              <select class="option_select" name={param_name} id={param_name}>
                <%= for option <- options do %>
                  <option value={Atom.to_string(option)} selected={option == value}>
                    <%= Display.humanize(option) %>
                  </option>
                <% end %>
              </select>
            </div>
          <% end %>

          <%= for %ValueParam{name: param_name, value: value} <- values do %>
            <div class="one_cmd_option">
              <div class="cmd_option_label"><%= Display.humanize(param_name) %></div>
              <input
                type="text"
                class="form-control bg-dark text-body"
                style="width:5rem;"
                name={param_name}
                value={value}
                phx-debounce="1500"
              />
              </div>
          <% end %>
        </form>
      <% end %>
    </div>
  <% end %>
</div>
