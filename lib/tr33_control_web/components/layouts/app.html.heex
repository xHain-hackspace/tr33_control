<main role="main" class="container"></main>

<div class="main">
  <div class="the_navi">

    <a class="header_home_link" href="/">
      <img src={~p"/images/xhain_logo_small.png"} width="100" height="100"/>
      <h1>tr33</h1>
      <h2><%= Application.get_env(:tr33_control, :title, "Control") %></h2>
    </a>

    <ul class="navi_list">
      <%= for {name, path} <- @navbar_content do %>
        <li>
          <%= live_redirect(name, to: path, class: "navi_item #{if path == @navbar_active_path, do: "active"}") %>
        </li>
      <% end %>
    </ul>

  </div>

  <h2 class="section_headline">commands</h2>

  <%= @inner_content %>

</div>
