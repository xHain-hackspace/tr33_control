<div>
  <%= if @live_action in [:new] do %>
    <Components.modal title="New preset">
      <div class="mb-2">Create new preset with the current commands?</div>
      <div class="form-group">
        <label> Preset Name</label>
        <input class="form-control" type="text" class="form-control" autofocus="autofocus" name="name" />
      </div>
      <br class="border-bottom" \ />
    </Components.modal>
  <% end %>

  <%= if @live_action in [:update] do %>
    <Components.modal title="Update preset" button_text="Save">
      <p>This will overwrite the preset <%= inspect(@current_preset) %> with the current commands. Are you sure?</p>
    </Components.modal>
  <% end %>

  <%= if @live_action in [:delete] do %>
    <Components.modal title="Delete Preset" button_text="Delete" , button_class="danger">
      <p>Are you sure out want to delete preset <%= inspect(@current_preset) %>?</p>
    </Components.modal>
  <% end %>

  <%= if not is_nil(@info) do %>
    <div class={"alert alert-#{@info.class}"}>
      <%= @info.text %>
    </div>
  <% end %>

  <div class="p-3">
    New Preset: <button type="button" class="presets_option_btn" phx-click="new">New Preset</button>
  </div>

  <table class="table table-hover">
    <tbody>
      <%= for %Preset{name: name} <- @presets do %>
        <tr class="table-active">
          <td><%= name %></td>
          <td>
            <button type="button" class="presets_option_btn " phx-click="load" phx-value-name={name}>
              Load Preset
            </button>
          </td>
          <td>
            <button type="button" class="presets_option_btn" phx-click="update" phx-value-name={name}>
              Update Preset
            </button>
          </td>
          <td>
            <button type="button" class="presets_option_btn" phx-click="clone" phx-value-name={name}>
              Clone Preset
            </button>
          </td>
          <td>
            <button type="button" class="presets_option_btn" phx-click="delete" phx-value-name={name}>
              Delete Preset
            </button>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
