<div phx-window-keyup="keyup">
  <%= if @live_action in [:new] do %>
    <Components.modal title="Create new preset from current commands">
      <div class="form-group">
        <label> Preset Name</label>
        <input class="form-control" type="text" class="form-control" autofocus="autofocus" name="name">
      </div>
      <br class="border-bottom"\>
    </Components.modal>
  <% end %>

  <%= if @live_action in [:update] do %>
    <Components.modal title={"Update Preset #{inspect(@selected_preset)}"} button_text="Update">
      <p>This will update the preset with the current command settings.</p>
    </Components.modal>
  <% end %>

  <%= if @live_action in [:delete] do %>
    <Components.modal title={"Delete Preset #{inspect(@selected_preset)}"} button_text="Delete", button_class="danger">
      <p>Are you sure?</p>
    </Components.modal>
  <% end %>

  <Components.section_card>
    <:header>Presets</:header>
    <:buttons>
      <%= if @info != nil do %>
        <span class={"text-#{@info.class}"}><%= @info.text %></span>
      <% end %>
      <%# <button type="button" class="btn btn-dark" phx-click="new">New Preset</button>  %>
    </:buttons>

    <div class="presets_wrap">

      <Components.list_select options={Enum.map(@presets, & &1.name)}, active={@selected_preset} event="selected_preset_change" />

      <div class="presets_option_bar">
        <button type="button" class="presets_option_btn " phx-click="load">Load Preset</button>
        <button type="button" class="presets_option_btn" phx-click="new">New Preset</button>
        <button type="button" class="presets_option_btn" phx-click="update">Update Preset</button>
        <button type="button" class="presets_option_btn" phx-click="clone">Clone Preset</button>
        <button type="button" class="presets_option_btn" phx-click="delete">Delete Preset</button>
      </div>

    </div>
  </Components.section_card>
</div>
