<div class="mx-2">
  <Components.section>
    <:header>
      <div class="d-flex justify-content-start align-items-center">
        <span class="me-5">Presets</span>
        <div class="btn-group ms-3">         
          <%# todo: implement this  %>
          <button class="btn btn-primary" phx-click="reset_commands">Start from scratch</button>
        </div>
      </div>  
      </:header>
    <.live_component module={Tr33ControlWeb.PresetComponent} id="presets" />
  </Components.section>

  <Components.section>
    <:header>
      <div class="d-flex justify-content-start align-items-center">
        <span class="me-5">Mixer</span>
        <div class="btn-group ms-3">                   
          <button class="btn btn-dark" phx-click="add_command">Add Command</button>
          <button class="btn btn-dark" phx-click="delete_command">Delete Command</button>
        </div>
        <div class="btn-group ms-3">                   
          <button class="btn btn-dark" phx-click="increment_command_index">Shift left</button>
          <button class="btn btn-dark" phx-click="decrement_command_index">Shift right</button>
        </div>
      </div>  
      </:header>
    <div class="d-flex">
      <%= for index <- 0..@command_count-1 do %>    
        <div class="my-2 mx-4 xborder border-secondary">
          <.live_component module={Tr33ControlWeb.CommandHeaderComponent} id={index} active?={@active_command == index} />
        </div>
      <% end %>
    </div>
  </Components.section>

    <%# <div class="d-flex flex-column px-1">
      <button class="btn btn-dark btn-sm h-25 text-light my-1" phx-click="delete_command">-</button>
      <button class="btn btn-dark btn-sm h-75 text-light my-1" phx-click="add_command">+</button>
    </div> %>


  <Components.section>
    <:header>
      <div class="d-flex justify-content-start align-items-center">
        <span class="me-5">Edit Command</span>
        <div class="btn-group ms-3">          
          <%= for index <- 0..@command_count-1 do %>
            <button
              type="button"
              class={"btn btn-lgx btn-" <> if @active_command == index, do: "warning", else: "outline-warning text-light"}
              phx-click="set_active_command"
              phx-value-index={index}
              >
              Command <%= index %>
            </button>
          <% end %>
        </div>
      </div>  
    </:header>
    
    <.live_component module={Tr33ControlWeb.CommandComponent} id="active_command" index={@active_command} />
  </Components.section>

  <Components.section>
    <:header>Targets</:header>
    <%= live_render(@socket, Tr33ControlWeb.TargetsLive, id: "targets") %>
  </Components.section>

  <Components.section>
    <:header>Joystick</:header>
    <%= live_render(@socket, Tr33ControlWeb.JoystickLive, id: "joystick") %>
  </Components.section>

</div> 

