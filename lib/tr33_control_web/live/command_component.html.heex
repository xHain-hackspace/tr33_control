<div>
  <Components.section_card>
    
    <:header><%= Command.type(@command) |> Display.humanize() %></:header>
    <:buttons>
      
      <%# Color Palette %>
      <div class="me-3">
        <form phx-change="palette_change" phx-target={@myself} phx-auto-recover="ignore">          
          <Inputs.select 
            target={ @myself } 
            param={ @color_palette_param }
            style={ :command }
            tabindex={ 3 }
            id={"palette_#{@command.index}"}
          />
        </form>
      </div>

      <%# Strip Index %>
      <%= if length(@strip_index_options) > 0  do %>
        <div class="me-3">
          <form phx-change="strip_index_change" phx-target={@myself} phx-auto-recover="ignore">
            <Inputs.select         
              target={ @myself }
              value={ Display.strip_index_name(@command, @strip_index_options) }
              options={ @strip_index_options }
              name={ :strip_index }
              style={ :command }  
              id={"strip_index_#{@command.index}"}
            />
          </form>
        </div>
      <% end %>
        
        <%# Command index %>
        <div class="btn-group me-3">                           
          <button class="btn btn-dark" phx-click="decrement_command_index" phx-target={@myself} >Move left</button>
          <button class="btn btn-dark" phx-click="increment_command_index" phx-target={@myself} >Move right</button>
        </div>

        <%# clone %>
        <div class="btn-group me-3">                           
          <button class="btn btn-dark" phx-click="clone_command" phx-target={@myself} >Clone</button>
        </div>
      
        <%# delete %>
        <div class="btn-group me-3">                           
          <button class="btn btn-dark" phx-click="delete_command" phx-target={@myself} >Delete</button>
        </div>
      
    </:buttons>
    
    <%# Controllers for params %>
    <div class="d-flex">
      <%= for param <- @value_params do %>
        <div class="d-flex flex-column align-items-center m-4" style="width:6rem;">
          <Inputs.slider param={ param } target={ @myself } tabindex={ 5 } />        
        </div>
      <% end %>

      <div class="d-flex flex-column" style="margin:2rem">
        <%= for param <- @enum_params do %>
          <div class="mb-3">
            <form phx-change="param_select_change" phx-target={@myself} phx-auto-recover="ignore">
              <Inputs.select param={ param } target={ @myself } />        
            </form>
          </div>
        <% end %>
      </div>
    </div>

    <%# Modifier %>
    <%= if @modifiers_active do %>
      <h4>Modifiers</h4>
      <div class="d-flex flex-column">

        <%# Activation bar %>
        <div class="d-flex justify-content-start">
          <div class="btn-group my-3">          
            <%= for name <- @modifier_names do %>
              <button
                type="button"
                class={"btn btn-" <> if modifier_active?(@command, name), do: "primary", else: "secondary"}
                phx-click={if modifier_active?(@command, name), do: "delete_modifier", else: "add_modifier"}
                phx-value-name={name}
                phx-target={@myself}
                >
                <%= Display.humanize(name) %>
              </button>
            <% end %>
          </div>
        </div>

        <%# Inputs %>
        <%= for {name, enums, values} <- @modifier_params do %>
          <div class="d-flex justify-content-start">
            <div class="mx-1 my-1">
                <form class="d-flex input-group" phx-change="update_modifier" phx-target={@myself}>
                  <input name="name" type="hidden" value={ name }>

                  <button type="button" class="btn btn-secondary text-start fw-bold" style="width: 8rem;" disabled>
                    <%= Display.humanize(name) %>
                  </button>

                  <%= for %EnumParam{options: options, name: param_name, value: value} <- enums do %>
                    <button type="button" class="btn btn-secondary ms-2" disabled><%= Display.humanize(param_name) %></button>
                    <select class="form-select custom-select bg-dark" name={ param_name } style="min-width:12rem;">
                      <%= for option <- options do %>
                        <option value={ Atom.to_string(option) } selected={ option == value } >
                          <%= Display.humanize(option) %>
                        </option>
                      <% end %>
                    </select>
                  <% end %>

                  <%= for %ValueParam{name: param_name, value: value} <- values do %>
                    <button class="btn btn-secondary ms-2" disabled><%= Display.humanize(param_name) %></button>
                    <input type="text" class="form-control bg-dark text-body" style="width:5rem;" name={param_name} value={value} phx-debounce="1500">
                  <% end %>

                  <%# <button type="submit" class="btn btn-primary ms-2">Apply</button> %>
              </form>

            </div>
          </div>
        <% end %>

      </div>

    <% end %>

  </Components.section_card>
</div>
