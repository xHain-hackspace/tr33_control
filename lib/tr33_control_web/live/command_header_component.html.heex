<div class="d-flex flex-column align-items-center" style="width:6rem;" phx-click="set_active_command" phx-value-index={@command.index}>
  <div class="h4 ">
    <span class={"badge bg-secondary border border-#{if @active?, do: "warning", else: "secondary"}"}>
      Command <%= @command.index %>
    </span>
  </div>

  <span class="badge bg-secondary mb-3">
    <%= Command.type(@command) |> Display.humanize() %>
  </span>
  
  <Inputs.slider param={@brightness_param} target={@myself} tabindex={1} />  
</div>
