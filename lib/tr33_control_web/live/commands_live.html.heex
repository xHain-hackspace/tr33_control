<div class="" phx-window-keyup="keyup">
  <%= if @live_action in [:new] do %>
    <Components.modal title="Select Type">      
      <Inputs.select 
        options={@command_types} 
        display_name={nil} 
        name="command_type" 
        value={:single_color} 
        background="secondary" 
        size={Enum.count(@command_types)}} 
        hook="set_focus"
      />

    </Components.modal>
  <% end %>

  <Components.section_card>
    <:header>Mixer</:header>
    
    <:buttons>
      <button class="btn btn-dark" phx-click="add_command">Add Command</button>
    </:buttons>

    <div class="d-flex">
      <%= for index <- 0..@command_count-1 do %>    
        <div class="my-2 mx-2">
          <.live_component module={Tr33ControlWeb.CommandHeaderComponent} id={index} active?={@active_command == index} />
        </div>
      <% end %>
    </div>
    
  </Components.section_card>

  <.live_component module={Tr33ControlWeb.CommandComponent} id="active_command" index={@active_command} />
</div> 

